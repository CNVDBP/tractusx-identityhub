+import org.junit.jupiter.api.Test;
+
+import java.time.Instant;
+
+import static org.eclipse.edc.junit.assertions.AbstractResultAssert.assertThat;
+import static org.mockito.Mockito.mock;
+
+class SelfIssuedTokenJtiValidationRuleTest {
+    @Test
+    void rejectsReplayAcrossVerifiersDuringClockAllowance() {
+        var store = new InMemoryJtiValidationStore();
+        var first = new SelfIssuedTokenJtiValidationRule(store, mock());
+        var second = new SelfIssuedTokenJtiValidationRule(store, mock());
+        var expiry = Instant.now().plusSeconds(120).getEpochSecond();
+        var token = ClaimToken.Builder.newInstance().claim("jti", "unique-token").claim("exp", expiry).build();
+        assertThat(first.checkRule(token, null)).isSucceeded();
+        assertThat(second.checkRule(token, null)).isFailed();
+        org.assertj.core.api.Assertions.assertThat(token.getClaim("exp")).isEqualTo(expiry);
+        org.assertj.core.api.Assertions.assertThat(store.findById("unique-token").expirationTimestamp()).isEqualTo((expiry + 5) * 1000);
+    }
+
+    @Test
+    void rejectsMissingNonceOrExpiration() {
+        var rule = new SelfIssuedTokenJtiValidationRule(new InMemoryJtiValidationStore(), mock());
+        assertThat(rule.checkRule(ClaimToken.Builder.newInstance().claim("exp", 1L).build(), null)).isFailed();
+        assertThat(rule.checkRule(ClaimToken.Builder.newInstance().claim("jti", " ").claim("exp", 1L).build(), null)).isFailed();
+        assertThat(rule.checkRule(ClaimToken.Builder.newInstance().claim("jti", "unique").build(), null)).isFailed();
+    }
+}
