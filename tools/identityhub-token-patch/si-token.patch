+class SelfIssuedTokenDidTest {
+    private static final String SENDER = "did:web:sender.example";
+    private static final String RECIPIENT = "did:web:recipient.example";
+    private static final String KEY_ID = SENDER + "#key";
+    private final DidResolverRegistry dids = mock();
+    private ECKey key;
+    private VerificationMethod method;
+    private SelfIssuedTokenVerifierImpl verifier;
+
+    @BeforeEach
+    void setUp() throws JOSEException {
+        key = new ECKeyGenerator(Curve.P_256).generate();
+        method = VerificationMethod.Builder.newInstance().id(KEY_ID).type("JsonWebKey2020")
+                .controller(SENDER).publicKeyJwk(key.toPublicJWK().toJSONObject()).build();
+        KeyParserRegistry parser = mock();
+        when(parser.parse(anyString())).thenReturn(Result.success(key.toECPublicKey()));
+        KeyPairResourcePublicKeyResolver local = mock();
+        when(local.resolveKey(anyString(), eq("recipient"))).thenReturn(Result.success(key.toECPublicKey()));
+        IdentityHubParticipantContextService participants = mock();
+        when(participants.rejectIfDeactivated("recipient")).thenReturn(ServiceResult.success(
+                IdentityHubParticipantContext.Builder.newInstance().participantContextId("recipient")
+                        .did(RECIPIENT).apiTokenAlias("test").build()));
+        var rules = new TokenValidationRulesRegistryImpl();
+        var replay = new SelfIssuedTokenJtiValidationRule(new InMemoryJtiValidationStore(), mock());
+        rules.addRule(DCP_PRESENTATION_SELF_ISSUED_TOKEN_CONTEXT, replay);
+        rules.addRule(DCP_PRESENTATION_ACCESS_TOKEN_CONTEXT, replay);
+        verifier = new SelfIssuedTokenVerifierImpl(new TokenValidationServiceImpl(), local,
+                rules, new SelfIssuedTokenKeyResolver(parser, dids), participants, Clock.systemUTC());
+    }
+
+    @Test
+    void rejectsKeyWithoutCapabilityInvocation() throws JOSEException {
+        document(SENDER, List.of());
+        assertThat(verifier.verify(token(KEY_ID), "recipient")).isFailed();
+    }
+
+    @Test
+    void rejectsDocumentForDifferentDid() throws JOSEException {
+        document("did:web:other.example", List.of(KEY_ID));
+        assertThat(verifier.verify(token(KEY_ID), "recipient")).isFailed();
+    }
+
+    @Test
+    void acceptsAuthorizedKey() throws JOSEException {
+        document(SENDER, List.of(KEY_ID));
+        assertThat(verifier.verify(token(KEY_ID), "recipient")).isSucceeded();
+    }
+
+    @Test
+    void acceptsSingleAuthorizedKeyWithoutKid() throws JOSEException {
+        document(SENDER, List.of(KEY_ID));
+        assertThat(verifier.verify(token(null), "recipient")).isSucceeded();
+    }
+
+    @Test
+    void rejectsReplayOfSignedTokenWithoutKid() throws JOSEException {
+        document(SENDER, List.of(KEY_ID));
+        var token = token(null);
+        assertThat(verifier.verify(token, "recipient")).isSucceeded();
+        assertThat(verifier.verify(token, "recipient")).isFailed();
+    }
+
+    @Test
+    void rejectsMultipleMethodsWithoutKidEvenIfOnlyOneIsAuthorized() throws JOSEException {
+        var other = VerificationMethod.Builder.newInstance().id(SENDER + "#other").type("Unsupported")
+                .controller(SENDER).publicKeyJwk(key.toPublicJWK().toJSONObject()).build();
+        when(dids.resolve(SENDER)).thenReturn(Result.success(DidDocument.Builder.newInstance().id(SENDER)
+                .verificationMethod(List.of(method, other)).capabilityInvocation(List.of(KEY_ID)).build()));
+        assertThat(verifier.verify(token(null), "recipient")).isFailed();
+    }
+
+    @Test
+    void rejectsSingleUnauthorizedMethodWithoutKid() throws JOSEException {
+        document(SENDER, List.of());
+        assertThat(verifier.verify(token(null), "recipient")).isFailed();
+    }
+
+    @Test
+    void acceptsRelativeVerificationMethodAndCapabilityReference() throws JOSEException {
+        method = VerificationMethod.Builder.newInstance().id("#key").type("JsonWebKey2020")
+                .controller(SENDER).publicKeyJwk(key.toPublicJWK().toJSONObject()).build();
+        document(SENDER, List.of("#key"));
+        assertThat(verifier.verify(token(KEY_ID), "recipient")).isSucceeded();
+    }
+
+    @Test
+    void rejectsUnknownKid() throws JOSEException {
+        document(SENDER, List.of(KEY_ID));
+        assertThat(verifier.verify(token(SENDER + "#unknown"), "recipient")).isFailed();
+    }
+
+    private void document(String id, List<String> capabilities) {
+        when(dids.resolve(SENDER)).thenReturn(Result.success(DidDocument.Builder.newInstance().id(id)
+                .verificationMethod(List.of(method)).capabilityInvocation(capabilities).build()));
+    }
+
+    private String token(String kid) throws JOSEException {
+        var access = sign(KEY_ID, claims().issuer(RECIPIENT).subject(SENDER).claim("scope", "test").build());
+        return sign(kid, claims().issuer(SENDER).subject(SENDER).claim("token", access).build());
+    }
+
+    private JWTClaimsSet.Builder claims() {
+        return new JWTClaimsSet.Builder().audience(RECIPIENT).jwtID(UUID.randomUUID().toString())
+                .issueTime(new Date()).expirationTime(Date.from(Instant.now().plusSeconds(120)));
+    }
+
+    private String sign(String kid, JWTClaimsSet claims) throws JOSEException {
+        var jwt = new SignedJWT(new JWSHeader.Builder(JWSAlgorithm.ES256).keyID(kid).build(), claims);
+        jwt.sign(new ECDSASigner(key));
+        return jwt.serialize();
+    }
+}
