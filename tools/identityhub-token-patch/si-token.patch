+package org.eclipse.edc.identityhub.verification;
+
+import com.nimbusds.jose.jwk.JWK;
+import org.eclipse.edc.iam.did.spi.document.DidDocument;
+import org.eclipse.edc.iam.did.spi.resolution.DidResolverRegistry;
+import org.eclipse.edc.keys.spi.KeyParserRegistry;
+import org.eclipse.edc.spi.result.Result;
+import org.jetbrains.annotations.Nullable;
+
+import java.security.PublicKey;
+import java.text.ParseException;
+
+import static org.eclipse.edc.iam.did.spi.document.DidConstants.ALLOWED_VERIFICATION_TYPES;
+
+/** Resolves SI token keys from the same DID document whose identity and key authorization are checked. */
+public class SelfIssuedTokenKeyResolver {
+    private final KeyParserRegistry parsers;
+    private final DidResolverRegistry dids;
+
+    public SelfIssuedTokenKeyResolver(KeyParserRegistry parsers, DidResolverRegistry dids) {
+        this.parsers = parsers;
+        this.dids = dids;
+    }
+
+    public Result<PublicKey> resolveKey(String issuer, @Nullable String kid) {
+        return dids.resolve(issuer)
+                .compose(document -> selectKey(document, issuer, kid))
+                .compose(parsers::parse)
+                .compose(key -> key instanceof PublicKey publicKey ? Result.success(publicKey)
+                        : Result.failure("Verification method did not contain public key material."));
+    }
+
+    private Result<String> selectKey(DidDocument document, String issuer, @Nullable String kid) {
+        if (!issuer.equals(document.getId())) {
+            return Result.failure("SI token issuer does not match the resolved DID document id.");
+        }
+        var methods = document.getVerificationMethod();
+        if (kid == null && methods.size() != 1) {
+            return Result.failure("Without kid, the DID document must contain exactly one verification method.");
+        }
+        if (methods.stream().map(vm -> absoluteId(issuer, vm.getId())).distinct().count() != methods.size()) {
+            return Result.failure("Every verification method must have a unique ID.");
+        }
+        var selected = methods.stream().filter(vm -> kid == null || kid.equals(absoluteId(issuer, vm.getId()))).toList();
+        if (selected.size() != 1) {
+            return Result.failure("No unique verification method matches kid.");
+        }
+        var method = selected.get(0);
+        if (method.getType() == null || !ALLOWED_VERIFICATION_TYPES.contains(method.getType())) {
+            return Result.failure("Unsupported verification method type.");
+        }
+        var id = absoluteId(issuer, method.getId());
+        if (id == null || document.getCapabilityInvocation().stream().noneMatch(ref -> id.equals(absoluteId(issuer, ref)))) {
+            return Result.failure("SI token signing key lacks capabilityInvocation authorization.");
+        }
+        if (method.getPublicKeyJwk() == null) {
+            return Result.failure("Verification method has no public JWK.");
+        }
+        try {
+            return Result.success(JWK.parse(method.getPublicKeyJwk()).toJSONString());
+        } catch (ParseException e) {
+            return Result.failure("Invalid public JWK in verification method.");
+        }
+    }
+
+    private @Nullable String absoluteId(String did, @Nullable String id) {
+        return id != null && id.startsWith("#") ? did + id : id;
+    }
+}
