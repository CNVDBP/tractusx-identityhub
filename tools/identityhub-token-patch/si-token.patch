+/** Requires a nonce and retains it throughout the DCP validators' five-second clock allowance. */
+public class SelfIssuedTokenJtiValidationRule extends JtiValidationRule {
+    public SelfIssuedTokenJtiValidationRule(JtiValidationStore store, Monitor monitor) {
+        super(store, monitor);
+    }
+
+    @Override
+    public Result<Void> checkRule(@NotNull ClaimToken token, @Nullable Map<String, Object> additional) {
+        var jti = token.getClaim("jti");
+        var expiry = token.getInstantClaim("exp");
+        if (!(jti instanceof String id) || id.isBlank() || expiry == null) {
+            return Result.failure("JTI validation requires a non-blank jti and an exp claim.");
+        }
+        // Extend only the store retention; the original token's expiration validation is unchanged.
+        var retained = ClaimToken.Builder.newInstance().claims(token.getClaims())
+                .claim("exp", expiry.plusSeconds(5).getEpochSecond()).build();
+        return super.checkRule(retained, additional);
+    }
+}
